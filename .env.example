# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used to create student/staff logins and by the jobs scraper. Never expose this.
SUPABASE_SECRET_KEY=sb_secret_...
# Resend → API Keys. Server-only. Emails website form submissions (enquiries, apply popup) to FORM_EMAIL_TO.
RESEND_API_KEY=re_...
FORM_EMAIL_TO=websitemillennium5@gmail.com
# Optional sender. Defaults to onboarding@resend.dev, which only delivers to the Resend account's own address
# until you verify a domain in Resend and set e.g. "Millennium Website <forms@yourdomain.com>".
RESEND_FROM=
